{
  "name": "mcc-owner-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "wrangler dev --local",
    "typecheck": "tsc --noEmit",
    "pretest": "wrangler deploy --dry-run --outdir .test-output",
    "test": "node --test tests/*.test.mjs",
    "preview:qa": "npm run build && wrangler deploy --dry-run --outdir .test-output && node tests/preview.mjs",
    "db:local": "wrangler d1 migrations apply mcc-office --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "jose": "6.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
