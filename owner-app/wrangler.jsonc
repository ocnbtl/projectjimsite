{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcc-office",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "mcc-office", "database_id": "local-only-not-provisioned", "migrations_dir": "migrations" }],
  "vars": { "APP_ORIGIN": "http://localhost:8787", "ENVIRONMENT": "local" },
  "observability": { "enabled": false }
}
