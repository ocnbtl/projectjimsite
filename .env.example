# Use the final canonical domain only when the production domain is connected.
NEXT_PUBLIC_SITE_URL=https://masonrycolorcorrections.com

# Server-only consultation delivery. Add after the business inbox and sending
# domain are ready; never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=re_replace_with_resend_api_key
CONTACT_TO_EMAIL=contact@masonrycolorcorrections.com
CONTACT_FROM_EMAIL=MCC Website <website@send.masonrycolorcorrections.com>

# Optional Cloudflare Turnstile protection for the consultation form. Set both
# values together in Production. The site key is public; the secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Optional consent-first PostHog browser analytics. These are public browser
# configuration values, not server secrets. The site relays consented traffic
# through /mcc-route; this host identifies the PostHog region and dashboard.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
